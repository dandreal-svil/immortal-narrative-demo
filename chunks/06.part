    if (button.dataset.identity) { state.identity = button.dataset.identity; emit("prototype_identity_selected", { identity: state.identity }); return setStep(2); }
    if (button.dataset.mode) { state.mode = button.dataset.mode; emit("prototype_mode_selected", { mode: state.mode, identity: state.identity }); emit("prototype_battle_start", { mode: state.mode, identity: state.identity }); return setStep(4); }
    if (button.dataset.firstMove) { state.firstMove = button.dataset.firstMove; return setStep(5); }
    if (button.dataset.finalMove) {
      state.finalMove = button.dataset.finalMove;
      state.result = state.firstMove === "observe" && state.finalMove === "memory" ? "mastered" : state.finalMove === "memory" || (state.firstMove === "observe" && state.finalMove === "run") ? "survived" : "wounded";
      emit("prototype_battle_complete", { mode: state.mode, firstMove: state.firstMove, finalMove: state.finalMove, result: state.result });
      return setStep(6);
    }
  });

  app.addEventListener("submit", (event) => {
    if (event.target.id !== "feedback-form") return;
    event.preventDefault();
    const data = Object.fromEntries(new FormData(event.target).entries());
    const record = { ...data, sessionId: sessionId(), mode: state.mode, identity: state.identity, firstMove: state.firstMove, finalMove: state.finalMove, battleResult: state.result, createdAt: new Date().toISOString(), qaOnly: true };
    const key = "immortal-narrative-demo-feedback";
    try {
      const records = JSON.parse(localStorage.getItem(key) || "[]");
      records.push(record);
      localStorage.setItem(key, JSON.stringify(records));
      state.message = "Le risposte sono state salvate localmente su questo dispositivo.";
    } catch {
      state.message = "Feedback completato. In questo ambiente il browser non consente il salvataggio locale.";
    }
    emit("prototype_feedback_local", { wantsContinue: data.wantsContinue, battleUnderstanding: data.battleUnderstanding, overallRating: data.overallRating });
    setStep(9);
  });

  emit("prototype_start", { source: new URLSearchParams(location.search).get("source") || "direct" });
  render();
})();
